# ─────────────────────────────────────────────────
# Backend — FastAPI
# ─────────────────────────────────────────────────
FASTAPI_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# ─────────────────────────────────────────────────
# Frontend — Next.js
# Copy this as frontend/.env.local
# ─────────────────────────────────────────────────
# URL of the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
